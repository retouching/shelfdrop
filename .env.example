# Copy to .env (never committed). Read by Settings and by docker/compose.yaml.

# Required: an address where the operator can be reached, sent in the User-Agent of every
# request to a metadata source.
SHELFDROP_CONTACT=

# Optional.
# SHELFDROP_LOG_LEVEL=INFO
# SHELFDROP_LOG_FORMAT=json
# SHELFDROP_DATA_DIR=.data
# SHELFDROP_API_PREFIX=/api
# Read by Compose alone: the loopback port of the API and the address of the reverse proxy.
# SHELFDROP_API_PORT=8000
# SHELFDROP_PROXY_ADDRESS=127.0.0.1
