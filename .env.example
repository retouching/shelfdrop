# Copy to .env (never committed), mode 600: it holds the key of the secrets. Read by Settings
# and by docker/compose.yaml.

# Required: an address where the operator can be reached, sent in the User-Agent of every
# request to a metadata source.
SHELFDROP_CONTACT=

# Required: the key the secrets of the database are sealed with, 32 characters at least
# (openssl rand -base64 32). Losing it loses the secrets.
SHELFDROP_SECRET_KEY=

# Imported once into the database at the first start where they are set; then the settings
# page holds them and a later change here is ignored.
# The address of Jellyfin, where the accounts sign in. Set at the first start, it skips the
# set-up of the first launch (the internal account is then created on the settings page).
# SHELFDROP_JELLYFIN_URL=http://jellyfin:8096
# The address of Prowlarr and its API key (Prowlarr > Settings > General).
# SHELFDROP_PROWLARR_URL=http://prowlarr:9696
# SHELFDROP_PROWLARR_API_KEY=
# The Client ID of the MyAnimeList API (https://myanimelist.net/apiconfig).
# SHELFDROP_MYANIMELIST_CLIENT_ID=
# The webhook of Discord the journal posts on (Discord > channel > Integrations > Webhooks).
# SHELFDROP_DISCORD_WEBHOOK=

# Optional.
# The address of the pages, linked by the messages of the journal.
# SHELFDROP_PUBLIC_URL=https://shelfdrop.example.com
# SHELFDROP_LOG_LEVEL=INFO
# SHELFDROP_LOG_FORMAT=json
# SHELFDROP_DATA_DIR=.data
# SHELFDROP_API_PREFIX=/api
# Read by Compose alone: the loopback port of the API and the address of the reverse proxy.
# SHELFDROP_API_PORT=8000
# SHELFDROP_PROXY_ADDRESS=127.0.0.1
# Read by Compose alone: the folder of the torrents and of the libraries the placement worker
# mounts on /data, and the group that owns their files.
# SHELFDROP_MEDIA_DIR=/srv/media
# SHELFDROP_LIBRARY_GID=1000
